# Code, configs, manifests, results tables and reports are tracked.
# Pixels, video, datasets, weights and bulky run outputs are not: they live
# out-of-band, identified by the manifests / hashes that ARE tracked.

# ---- imagery -------------------------------------------------------------
*.png
*.jpg
*.jpeg
*.bmp
*.tif
*.tiff
*.webp

# ---- video ---------------------------------------------------------------
*.mp4
*.ts
*.mkv
*.avi
*.mov
*.seq
*.csq

# ---- archives (dataset / run transfers) ------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz

# ---- model weights and run outputs ------------------------------------------
*.pt
*.pth
*.ckpt
*.engine
*.onnx
events.out.tfevents*
runs/
rfdetr_medium_thermal_640/

# ---- pixel data trees ------------------------------------------------------
data/**/rgb/
data/**/thermal/
data/**/calib_preview/
data/raw/
data/unpaired/
data/**/solutions_cache.json
detection/data/
thermal-yolo/
thermal-1/
thermal-1-filtered/
track_review/

# YOLO label files live inside the (ignored) dataset trees; stray .txt too
*.txt
!requirements*.txt

# ---- local scratch ---------------------------------------------------------
scratch/

